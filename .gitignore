# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# generated framework agent hints (recreated by Next.js development server)
/AGENTS.md
/CLAUDE.md

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
/artifacts/*.local.json
/transfer/

# duplicated project snapshot artifacts (auto-generated by tooling, not source)
/.openai/
/db/
/HititFinLex/

# generated benchmark reports (not source)
backend/tools/evren_benchmark_report*.md
