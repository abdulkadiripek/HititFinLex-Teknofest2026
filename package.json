{
  "name": "katilim-finans-rag",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev",
    "dev:sites": "vite",
    "build": "node scripts/build-verified.mjs",
    "start": "node scripts/start-production.mjs",
    "test": "npm run build && npm run test:smoke",
    "test:smoke": "node --test tests/rendered-html.test.mjs tests/frontend-safety.test.mjs",
    "lint": "node scripts/run-with-env.mjs eslint app build scripts tests vite.config.ts next.config.ts eslint.config.mjs",
    "typecheck": "node scripts/run-with-env.mjs tsc --noEmit",
    "artifacts": "node scripts/artifact-manifest.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module",
  "displayName": "Katilim Finans RAG"
