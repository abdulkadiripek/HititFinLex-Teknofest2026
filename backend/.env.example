# Copy to backend/.env. This file intentionally contains no real credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=katilim_finans
# Runtime role: CRUD only. Do not put the postgres or migration role here.
DB_USER=hititfinlex_app
DB_PASSWORD=CHANGE_ME_APP_LOCAL_ONLY
DATA_DIR=./data

# Schema provisioning is run only from db/provision.py. Keep these privileged
# credentials out of the runtime process and replace every password locally.
POSTGRES_DB=katilim_finans
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_LOCAL_ONLY
DB_MIGRATOR_USER=hititfinlex_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_LOCAL_ONLY

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MAX_OUTPUT_TOKENS=768

# LLM provider used by /chat and /history/chat. The default is the fully local
# Ollama path. Set "evren" only after reviewing the external data flow and
# configuring a real credential in the ignored backend/.env file.
LLM_PROVIDER=ollama
EVREN_API_KEY=CHANGE_ME_TEAM_EVREN_KEY
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_TEXT_MODEL=llm-fast
EVREN_EMBEDDING_MODEL=bge-m3-embed
EVREN_EMBEDDING_DIMENSION=1024
EVREN_TIMEOUT_SECONDS=180
EVREN_CONNECT_TIMEOUT_SECONDS=10
EVREN_MAX_RETRIES=2
EVREN_MAX_OUTPUT_TOKENS=768

# Team-isolated Qdrant credentials. Keep the real key only in ignored .env.
QDRANT_URL=https://evren-vektor.ssyz.org.tr/TEAM_PATH/
QDRANT_API_KEY=CHANGE_ME_TEAM_QDRANT_KEY
QDRANT_COLLECTION=hititfinlex_rag_v2
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=2

# RAG V2 retrieval, confidence, pooling, and session defaults.
RAG_V2_DENSE_WEIGHT=1.0
RAG_V2_LEXICAL_WEIGHT=0.5
RAG_V2_RRF_K=60
RAG_V2_PRODUCT_SOFT_BOOST=0.001
RAG_V2_ACCEPTED_CONFIDENCE=0.80
RAG_V2_REVIEW_CONFIDENCE=0.65
RAG_V2_ENFORCE_CLASSIFICATION_POLICY=false
RAG_V2_REQUIRE_TEXTUAL_PRODUCT_CONFIRMATION=false
RAG_V2_DB_POOL_MIN_SIZE=2
RAG_V2_DB_POOL_MAX_SIZE=10
RAG_V2_DB_POOL_TIMEOUT_SECONDS=10
RAG_V2_DB_STATEMENT_TIMEOUT_MS=5000
RAG_V2_SESSION_TTL_SECONDS=2592000
RAG_V2_HISTORY_TURNS=6
RAG_V2_HISTORY_MAX_CHARS=16000
RAG_V2_CONVERSATION_SUMMARY_MAX_CHARS=32000
RAG_V2_TRANSCRIPT_TURNS=100
RAG_V2_MAX_EVIDENCE=12
RAG_V2_MAX_BANK_EVIDENCE=12
RAG_V2_CANDIDATE_MULTIPLIER=8
RAG_V2_ROUTE_WITH_LLM=true
RAG_V2_RERANKER_ENABLED=false
RAG_V2_RERANKER_VALIDATED=false
RAG_V2_CHUNK_MAX_WORDS=220
RAG_V2_CHUNK_OVERLAP_WORDS=40
RAG_V2_INDEX_DOCUMENT_BATCH_SIZE=16
RAG_V2_EMBEDDING_BATCH_SIZE=64

# Legacy endpoints use the same pool and may run local embeddings on CPU.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
# LOCAL_EMBEDDING_DEVICE=cpu

# Admin writes and all /reviews routes fail closed until this is replaced.
# This literal placeholder is deliberately rejected by api_security.py.
HITITFINLEX_ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Comma-separated exact frontend origins. Credentials are disabled by default.
HITITFINLEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HITITFINLEX_CORS_ORIGIN_REGEX=
HITITFINLEX_CORS_ALLOW_CREDENTIALS=false

# Request hardening defaults (bytes and requests per rolling minute).
HITITFINLEX_MAX_BODY_BYTES=1048576
HITITFINLEX_RATE_LIMIT_PER_MINUTE=120
HITITFINLEX_ADMIN_RATE_LIMIT_PER_MINUTE=30
HITITFINLEX_TRUST_PROXY_HEADERS=false

# Optional shared Hugging Face cache (use a local absolute path when needed).
# HF_HOME=C:/Users/your-user/AI/hf-cache
